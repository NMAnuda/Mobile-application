<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_blue_gray"
    android:padding="16dp">


    <LinearLayout
        android:layout_width="376dp"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:contentDescription="Car Icon"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="AUTO SERVICE"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="370dp"
        android:layout_height="82dp">

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="378dp"
        android:layout_height="478dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/card_background"
        android:backgroundTint="@color/material_dynamic_neutral100"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Booking Confirmation Content -->
        <LinearLayout
            android:layout_width="351dp"
            android:layout_height="413dp"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Header: Booking Successfully Arrived -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="334dp"
                android:layout_height="93dp">

                <View
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:background="@drawable/right"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.498"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking Successfully Arrived"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Hardcoded Checkmark (using a simple View with a green background) -->
            </LinearLayout>

            <!-- Booking Code -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Booking Code: "
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/booking_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="ABC123"
                    android:textColor="#FF0000"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Date & Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <!-- Hardcoded Calendar Icon (using a simple View with a gray background) -->
                <View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/card_background_rounded"
                    android:backgroundTint="@color/design_default_color_error" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date / Time: "
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/date_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="2:40 - 4:10"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Service -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <!-- Hardcoded Wrench Icon (using a simple View with a gray background) -->
                <View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/card_background_rounded"
                    android:backgroundTint="@color/design_default_color_error" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service: "
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/service"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Basic Maintenance Package"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- Hardcoded Location Pin Icon (using a simple View with a gray background) -->
                <View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/card_background_rounded"
                    android:backgroundTint="@color/design_default_color_error" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location: "
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="123 Auto Lane, Suite 45, MALABE"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Buttons -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="334dp"
                android:layout_height="61dp">

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Download Receipt Button -->
                <Button
                    android:id="@+id/download_receipt_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_background"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:text="Download Receipt"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <!-- Copy Code Button -->
                <Button
                    android:id="@+id/copy_code_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_background"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:text="Copy Code"
                    android:textColor="#000000"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="173dp">


        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation3"
            android:layout_width="376dp"
            android:layout_height="75dp"
            android:background="@drawable/nav_button_background"
            android:elevation="8dp"
            app:backgroundTint="@color/material_dynamic_neutral100"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/nav_item_tint_selector"
            app:itemRippleColor="@color/nav_ripple"
            app:itemTextAppearanceActive="@style/NavTextActive"
            app:itemTextAppearanceInactive="@style/NavTextInactive"
            app:itemTextColor="@color/nav_item_tint_selector"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.836"
            app:menu="@menu/nav" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>